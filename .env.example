# Copia este archivo a ".env" y rellena tus claves.
# Los scripts y la app lo cargan automaticamente desde la raiz del repo.

# Claude — reescrituras de texto por nivel (OPCIONAL: si no la pones, los
# textos se generan con Gemini usando la clave de Google de abajo).
# Consigue tu clave en: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=sk-ant-...

# Gemini — imagenes por estilo y, si no hay clave de Claude, tambien los textos
# Consigue tu clave en: https://aistudio.google.com/apikey
# Puedes usar GOOGLE_API_KEY o GEMINI_API_KEY (cualquiera de las dos vale;
# si defines ambas, GOOGLE_API_KEY tiene prioridad).
GOOGLE_API_KEY=AIzaSyDClrTFI_a518hBAk6TdenMxIPcHFJRUjo
# GEMINI_API_KEY=...

# Opcionales (tienen valores por defecto):
# Idioma de los textos y la narracion (por defecto espanol)
# ESCALATE_LANGUAGE=es
# Voz del narrador (por defecto masculina espanola, grave y pausada)
# ESCALATE_VOICE=es-ES-AlvaroNeural
# Ajustes para que suene mayor: mas lento y mas grave
# ESCALATE_VOICE_RATE=-8%
# ESCALATE_VOICE_PITCH=-12Hz
# Volumen de la musica de fondo (0 = sin musica)
# ESCALATE_MUSIC_VOLUME=0.25
# Fuente: track = pistas CC-BY de incompetech (por defecto);
# synth = ambiente sintetizado local, inmune a bloqueos de copyright
# ESCALATE_MUSIC_SOURCE=track
# Marca de agua abajo a la izquierda (por defecto "@sfsusers"; tambien
# configurable por ejecucion con --watermark / --no-watermark o en la UI)
# ESCALATE_WATERMARK=@sfsusers
